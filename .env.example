PORT=3000
DATA_DIR=./data
RING_REFRESH_TOKEN=replace_me
SNAPSHOT_RETENTION_DAYS=7
MAX_SNAPSHOTS=250

# --- Dashboard login (local only) ---
# Auth turns on automatically once a username and password hash are set.
# Leave both unset to run with no login (the app will warn loudly on startup).
AUTH_USERNAME=admin
# Generate a hash with: npm run auth:hash
AUTH_PASSWORD_HASH=
# Quick-start alternative: set a plaintext password instead of a hash.
# It is hashed at startup. AUTH_PASSWORD_HASH is preferred.
# AUTH_PASSWORD=
# How long a session stays valid (hours). Default 12.
# AUTH_SESSION_TTL_HOURS=12
# Force-disable auth even if credentials are set.
# AUTH_ENABLED=true
# Set true ONLY if you serve the dashboard over HTTPS (adds Secure to the cookie).
# AUTH_COOKIE_SECURE=false
